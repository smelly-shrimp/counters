<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counters.Models"
             x:Class="Counters.Components.Counter"
             x:DataType="models:Counter">
    <StackLayout>
        <Label Text="{Binding Value}"
               FontSize="48"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="{Binding BackgroundColor}" />
        <Label Text="{Binding Name}"
               FontSize="32"
               HorizontalTextAlignment="Center" />

        <Grid ColumnDefinitions="*, *"
              RowDefinitions="Auto, Auto"
              ColumnSpacing="8"
              RowSpacing="8">
            <Button Grid.Column="0"
                    Grid.Row="0"
                    Text="{Binding IncrementButtonLabel}"
                    Clicked="OnIncrementClicked" />
            <Button Grid.Column="1"
                    Grid.Row="0"
                    Text="{Binding DecrementButtonLabel}"
                    Clicked="OnDecrementClick" />

            <Button Grid.Column="0"
                    Grid.Row="1"
                    Text="{Binding ResetButtonLabel}"
                    Clicked="OnResetClicked" />
            <Button Grid.Column="1"
                    Grid.Row="1"
                    Text="{Binding DeleteButtonLabel}"
                    Clicked="OnDeleteClick" />
        </Grid>
    </StackLayout>
</ContentView>
